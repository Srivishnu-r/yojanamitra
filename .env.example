# ============================================================================
#  YojanaMitra AI  -  environment configuration
#  Copy this file to .env.local and fill in the keys you have.
#  Every integration degrades gracefully: with no keys the app runs in
#  DEMO MODE using realistic local data so you can explore the full product.
# ============================================================================

# ---------------------------------------------------------------------------
# Google Gemini  (free tier - https://aistudio.google.com/apikey)
# Powers the assistant / agentic reasoning + tool calling.
# ---------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_FALLBACK_MODELS=gemini-3.8-flash,gemini-3.5-flash

# ---------------------------------------------------------------------------
# Sarvam AI  (https://dashboard.sarvam.ai)
# Powers Indic translation, speech-to-text and text-to-speech.
# ---------------------------------------------------------------------------
SARVAM_API_KEY=
SARVAM_TRANSLATE_MODEL=sarvam-translate:v1
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_DEFAULT_SPEAKER=priya

# ---------------------------------------------------------------------------
# DigiLocker  (https://developers.digilocker.gov.in)
# Partner OAuth 2.0 + PKCE. Used to fetch the citizen's issued documents.
# Leave blank to use the built-in DigiLocker simulator.
# ---------------------------------------------------------------------------
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_USE_SANDBOX=true
DIGILOCKER_BASE_URL=https://api.digilocker.gov.in/public/oauth2/1
DIGILOCKER_SANDBOX_BASE_URL=https://sandbox.digilocker.gov.in/public/oauth2/1
DIGILOCKER_REDIRECT_URI=http://localhost:3000/api/digilocker/callback

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000
SESSION_SECRET=change-me-in-production
# Force demo mode even when keys are present (useful for screenshots/demos)
FORCE_DEMO_MODE=0
